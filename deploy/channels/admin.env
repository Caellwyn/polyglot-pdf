# ADMIN service -- Cloud Run configuration for polyglot-admin.
#
# Read by deploy-all.sh (read_channel_section) and by cloudbuild.yaml's
# admin-service target (bead 4.2). Format: see deploy/channels/README.md.
#
# NOT part of the staging/demo parity pair, deliberately. There is ONE admin
# service backing BOTH channels' data, so it has no channel of its own; its
# staging tier is the tagged no-traffic revision instead (bd polyglot-pdf-3l2vp,
# docs/doctrine/promotion-tiers.md admin-tier row).
#
# THE ONLY SOURCE, as of bd polyglot-pdf-oqtm7 (4.6). deploy-admin.sh used to
# compute these same values inline and pass them as BACKEND_EXTRA_ENV -- two
# live copies of one config, in two languages. That script is a thin trigger
# wrapper now, so this file is what the deployed service's env block is built
# from, whether the build was started from bash or from the admin console.
#
# --set-env-vars REPLACES the service's ENTIRE env block, so a key missing
# here is a key silently REMOVED from the running service at the next deploy,
# not one left at its previous value. Every OIDC caller identity below is
# therefore load-bearing: an empty one allowlists NOBODY and fail-closes its
# route (503). tests/test_deploy_admin_sweep_env_vars.py derives the required
# set from the routes themselves rather than a hand-typed list.
#
# NOT here, deliberately: ADMIN_SERVICE_URL and BACKEND_URLS_JSON. Google
# assigns the admin service's own URL at first deploy, and the admin service
# has no channel of its own so it cannot derive either public backend's URL --
# cloudbuild.yaml's admin-service target resolves all three live and appends
# them to what this file declares.

[SET_ENV_VARS]
# The ASGI target inside the ONE shared image. The Dockerfile's
# `CMD uvicorn ${APP_MODULE:-backend.main:app}` falls back to the public
# backend, so this key is what makes the same image serve the admin app.
APP_MODULE=admin_backend.main:app
# Every known cross-origin caller, on BOTH its .web.app and .firebaseapp.com
# aliases -- every Firebase Hosting site answers at both by default, and
# missing either means a page served from that domain is CORS-rejected.
# The admin CONSOLE is its own Vite app on its own sites; the main app's
# firm-console pages call this service directly from BOTH channels' origins.
CORS_EXTRA_ORIGINS=https://polyglot-admin-demo.web.app;https://polyglot-admin-demo.firebaseapp.com;https://polyglot-admin-candidate.web.app;https://polyglot-admin-candidate.firebaseapp.com;https://polyglot-app-staging.web.app;https://polyglot-app-staging.firebaseapp.com;https://polyglot-demo-aa709.web.app;https://polyglot-demo-aa709.firebaseapp.com
# The identity Cloud Scheduler presents on the refund sweep's OIDC token.
# Knowable ahead of the first deploy (scripts/setup-admin-service.sh creates
# it), unlike ADMIN_SERVICE_URL, which Google assigns at first deploy and
# deploy-admin.sh therefore still layers on from a live lookup.
SWEEP_SCHEDULER_SA_EMAIL=admin-sweep-scheduler-sa@polyglot-demo-aa709.iam.gserviceaccount.com
# The identity the Pub/Sub push subscription presents on the Cloud Build
# build-status webhook's OIDC token (bd polyglot-pdf-tb3kp, E4.3's
# require_google_oidc gate on POST /api/deploys/webhook). Knowable ahead of
# the first deploy (scripts/setup-admin-service.sh's PUBSUB_PUSH_SA_NAME is
# a fixed literal), same reasoning as SWEEP_SCHEDULER_SA_EMAIL immediately
# above. Fresh-eyes/cross-surface finding: this var was previously set by
# NO deploy path (only a hand-run NOTE that script printed), permanently
# fail-closing the webhook on every real deploy.
PUBSUB_PUSH_SA_EMAIL=admin-pubsub-push-sa@polyglot-demo-aa709.iam.gserviceaccount.com
# The identity Cloud Scheduler presents on the firm-plan monthly top-up
# route's OWN OIDC token (bd polyglot-pdf-0euzk). A THIRD, separate identity
# from the two above -- a Scheduler caller identity is never reused across
# jobs -- and knowable ahead of the first deploy for the same reason
# (scripts/setup-admin-service.sh's MONTHLY_TOPUP_SCHEDULER_SA_NAME is a fixed
# literal). It reached the service ONLY through deploy-admin.sh's inline env
# assembly until bd polyglot-pdf-oqtm7 retired that path, so it moved here
# with the rest rather than being dropped.
MONTHLY_TOPUP_SCHEDULER_SA_EMAIL=admin-topup-scheduler-sa@polyglot-demo-aa709.iam.gserviceaccount.com

[SET_SECRETS]
# None today. The section header stays so the parser's shape is uniform and
# adding the first binding is a one-line edit rather than a format decision.

[SERVICE_ACCOUNT]
# A DISTINCT runtime identity from the public backend's polyglot-backend-sa:
# the admin service reads and writes firm, credit, and audit data the voice
# backend must never be able to touch.
SERVICE_ACCOUNT=admin-backend-sa@polyglot-demo-aa709.iam.gserviceaccount.com
