# ADMIN service -- Cloud Run configuration for polyglot-admin.
#
# Read by deploy-all.sh (read_channel_section) and by cloudbuild.yaml's
# admin-service target (bead 4.2). Format: see deploy/channels/README.md.
#
# NOT part of the staging/demo parity pair, deliberately. There is ONE admin
# service backing BOTH channels' data, so it has no channel of its own; its
# staging tier is the tagged no-traffic revision instead (bd polyglot-pdf-3l2vp,
# docs/doctrine/promotion-tiers.md admin-tier row).
#
# DECLARATIVE ONLY TODAY. deploy-admin.sh still computes these same values
# inline and passes them as BACKEND_EXTRA_ENV, because two existing guards
# (tests/test_deploy_admin_cors_origins.py,
# tests/test_deploy_admin_sweep_env_vars.py) pin them there. This file is the
# source cloudbuild.yaml's admin-service target reads; switching the bash
# wrapper over -- and moving those two guards onto this file -- belongs with
# that target, in bead polyglot-pdf-ywxoh (4.2). The values below are
# therefore kept IN STEP with deploy-admin.sh by
# tests/test_cloudbuild_yaml.py::test_admin_channel_file_matches_the_wrapper,
# so the two cannot drift while both exist.

[SET_ENV_VARS]
# The ASGI target inside the ONE shared image. The Dockerfile's
# `CMD uvicorn ${APP_MODULE:-backend.main:app}` falls back to the public
# backend, so this key is what makes the same image serve the admin app.
APP_MODULE=admin_backend.main:app
# Every known cross-origin caller, on BOTH its .web.app and .firebaseapp.com
# aliases -- every Firebase Hosting site answers at both by default, and
# missing either means a page served from that domain is CORS-rejected.
# The admin CONSOLE is its own Vite app on its own sites; the main app's
# firm-console pages call this service directly from BOTH channels' origins.
CORS_EXTRA_ORIGINS=https://polyglot-admin-demo.web.app;https://polyglot-admin-demo.firebaseapp.com;https://polyglot-admin-candidate.web.app;https://polyglot-admin-candidate.firebaseapp.com;https://polyglot-app-staging.web.app;https://polyglot-app-staging.firebaseapp.com;https://polyglot-demo-aa709.web.app;https://polyglot-demo-aa709.firebaseapp.com
# The identity Cloud Scheduler presents on the refund sweep's OIDC token.
# Knowable ahead of the first deploy (scripts/setup-admin-service.sh creates
# it), unlike ADMIN_SERVICE_URL, which Google assigns at first deploy and
# deploy-admin.sh therefore still layers on from a live lookup.
SWEEP_SCHEDULER_SA_EMAIL=admin-sweep-scheduler-sa@polyglot-demo-aa709.iam.gserviceaccount.com

[SET_SECRETS]
# None today. The section header stays so the parser's shape is uniform and
# adding the first binding is a one-line edit rather than a format decision.

[SERVICE_ACCOUNT]
# A DISTINCT runtime identity from the public backend's polyglot-backend-sa:
# the admin service reads and writes firm, credit, and audit data the voice
# backend must never be able to touch.
SERVICE_ACCOUNT=admin-backend-sa@polyglot-demo-aa709.iam.gserviceaccount.com
