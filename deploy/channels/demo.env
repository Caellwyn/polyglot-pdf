# DEMO channel -- Cloud Run configuration for polyglot-backend.
#
# Read by deploy-all.sh (read_channel_section) and by cloudbuild.yaml's
# backend-demo target. Format: see deploy/channels/README.md.
#
# MIRRORS staging.env line for line except the keys in
# tests/test_deploy_channel_parity.py's CHANNEL_SPECIFIC allowlist. Change a
# setting in staging.env FIRST, verify there, then promote it here.

[SET_ENV_VARS]
# Vertex ADC, not an AI Studio key -- the runtime SA below holds
# roles/aiplatform.user.
VERTEXAI=true
USE_PREMIUM_MODEL=false
SPELLBACK_TOOL_ENABLED=true
# The maintainer's by-ear clarity setting, and the temperature every
# spell-back validation run used. Google's default is 1.0.
LIVE_TEMPERATURE=0.4
EXTRACTOR_MODEL=gemini-2.5-pro
# Client links. LINK_REDEMPTIONS_FIRESTORE_ENABLED is REQUIRED alongside
# minting, not optional: open_link raises RedemptionUnavailable when the store
# is off and the redemption gate fails CLOSED, so every minted link would 404.
LINK_MINTING_ENABLED=true
LINK_REDEMPTIONS_FIRESTORE_ENABLED=true
# CHANNEL-SPECIFIC. The channel name minted into every token as `aud` and
# verified on open (bd polyglot-pdf-3q9qn). Matching staging's value would put
# both channels on one redemption ledger.
LINK_CHANNEL=demo
# CHANNEL-SPECIFIC. The FRONTEND origin: a minted link is `<base>/f#t=<token>`
# and /f is a client-app route. Pointing the demo at a staging origin would mint
# links that open STAGING -- silently testing the wrong deployment.
LINK_BASE_URL=https://polyglot-demo-aa709.web.app
# The hosted schema editor calls Cloud Run DIRECTLY (dodging the Hosting
# rewrite's 60s cap), so it is genuinely cross-origin. The app's own pages use
# the /api/** rewrite and need no entry; the voice path is a WebSocket, which
# is not CORS-preflighted. Semicolon-separated, matching parse_extra_origins.
CORS_EXTRA_ORIGINS=https://polyglot-editor-demo.web.app;https://polyglot-editor-demo.firebaseapp.com

[SET_SECRETS]
# --set-secrets REPLACES the service's whole secret block, so this must name
# EVERY binding the service should keep. LINK_TOKEN_SECRET is the HMAC signing
# key for every link token; without it the mint route 503s. The secret itself
# is provisioned out of band -- this only binds its latest version.
LINK_TOKEN_SECRET=LINK_TOKEN_SECRET:latest

[SERVICE_ACCOUNT]
# The Cloud Run runtime identity. Explicit and versioned here for the first
# time (bd polyglot-pdf-1s3ko): it was previously an inline SA_EMAIL in the
# wrapper. Holds roles/aiplatform.user for the Vertex path and deliberately
# LACKS firebaseauth.users.get (CLAUDE.md scar #7).
SERVICE_ACCOUNT=polyglot-backend-sa@polyglot-demo-aa709.iam.gserviceaccount.com
