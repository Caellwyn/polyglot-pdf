{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "schema-editor",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "--prefix", "schema-editor", "dev"],
      "port": 3001
    },
    {
      "name": "schema-editor-hosted",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "--prefix", "schema-editor", "dev", "--", "--mode", "hosted"],
      "port": 3001
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "--prefix", "frontend", "dev"],
      "port": 5173
    }
  ]
}
