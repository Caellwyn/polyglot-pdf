# Hosted delivery mode for the admin console (bd polyglot-pdf-b6943):
# `npm run build:hosted` loads this file (vite --mode hosted).
#
# VITE_ADMIN_API_BASE_URL: the ADMIN service's Cloud Run URL (polyglot-admin),
# NOT the public backend. The console calls it DIRECTLY -- there is no
# Hosting /api rewrite in front of either admin site (firebase.json), matching
# the schema editor's own reasoning: a rewrite's 60s cap would be wrong for a
# console whose deploy-trigger routes (future epics) run long.
#
# FALLBACK ONLY: deploy-admin-console.sh resolves the LIVE admin service URL
# at deploy time and exports VITE_ADMIN_API_BASE_URL (which overrides this
# line), mirroring deploy-editor.sh's VITE_API_BASE_URL resolution -- the
# Cloud Run auto-URL hash is not stable across a service recreate. This
# committed value is used only if that resolution fails (or a local build
# with no gcloud); keep it roughly current but do not rely on it for deploys.
VITE_ADMIN_API_BASE_URL=https://polyglot-admin-won24rgefq-uc.a.run.app

# Firebase sign-in (bd polyglot-pdf-b6943, mirroring the schema editor's bd
# polyglot-pdf-yswp3). The console authenticates each person individually
# against the SAME Firebase project the voice app and schema editor use -- a
# second project is a separate epic's job, not this one's. These three keys
# are all sign-in needs (no storage/messaging/analytics ids: the console
# writes no Firestore profile and reads no allowlist collection of its own --
# access is gated by the app_admin CUSTOM CLAIM the admin service checks).
#
# NOT SECRETS: a Firebase web apiKey is a public client identifier, compiled
# into every browser bundle by design -- see schema-editor/.env.hosted for the
# same values and the same reasoning. Access is gated server-side by
# admin_backend/services/admin_auth.py's require_app_admin, granted per
# person with:
#   python scripts/bootstrap_admin_user.py --email you@example.com --project <PROJECT>
# Without that claim a valid sign-in is refused with 403, which is the point:
# holding the bundle grants nothing.
#
# A build missing these renders an explicit "no Firebase configuration"
# screen rather than a sign-in form that cannot work.
VITE_FIREBASE_API_KEY=AIzaSyCR83_76OkNbAlSWgrz4hMLkoTS4vrRaOg
VITE_FIREBASE_AUTH_DOMAIN=polyglot-demo-aa709.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=polyglot-demo-aa709
