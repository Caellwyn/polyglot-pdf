{
  "name": "polyglot-admin-console",
  "version": "1.0.0",
  "type": "module",
  "description": "Admin console: whoami, audit log, runtime config editor",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:hosted": "tsc && vite build --mode hosted",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "firebase": "^12.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.13.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "4.0.7",
    "@vitest/ui": "4.0.7",
    "autoprefixer": "^10.6.1",
    "jsdom": "^27.1.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.5.3",
    "vite": "^5.4.1",
    "vitest": "4.0.7"
  }
}
