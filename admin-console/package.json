{
  "name": "polyglot-admin-console",
  "version": "1.0.0",
  "type": "module",
  "description": "Admin console: whoami, audit log, runtime config editor",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:hosted": "tsc && vite build --mode hosted",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "5.0.0",
    "@vitest/ui": "5.0.0",
    "autoprefixer": "^10.6.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "5.0.0"
  }
}
