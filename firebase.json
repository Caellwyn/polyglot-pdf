{
    "firestore": {
        "rules": "firestore.rules"
    },
    "hosting": [
        {
            "target": "app",
            "public": "frontend/dist",
            "ignore": [
                "firebase.json",
                "**/.*",
                "**/node_modules/**"
            ],
            "rewrites": [
                {
                    "source": "/api/**",
                    "run": {
                        "serviceId": "polyglot-backend",
                        "region": "us-central1"
                    }
                },
                {
                    "source": "**",
                    "destination": "/index.html"
                }
            ]
        },
        {
            "target": "app-staging",
            "public": "frontend/dist",
            "ignore": [
                "firebase.json",
                "**/.*",
                "**/node_modules/**"
            ],
            "rewrites": [
                {
                    "source": "/api/**",
                    "run": {
                        "serviceId": "polyglot-backend-staging",
                        "region": "us-central1"
                    }
                },
                {
                    "source": "**",
                    "destination": "/index.html"
                }
            ]
        },
        {
            "target": "editor",
            "public": "schema-editor/dist",
            "ignore": [
                "firebase.json",
                "**/.*",
                "**/node_modules/**"
            ],
            "rewrites": [
                {
                    "source": "**",
                    "destination": "/index.html"
                }
            ]
        }
    ]
}
