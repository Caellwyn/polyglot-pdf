# Voice Form Filler - Backend Environment Variables
# Copy this file to .env and fill in your actual values

# === Authentication ===
# If using Vertex AI (VERTEXAI=true in config.py):
#   - No API key needed! Just run: gcloud auth application-default login
#   - The backend will use your gcloud credentials automatically
# If using Google AI Studio (VERTEXAI=false):
#   - You need a GEMINI_API_KEY from https://aistudio.google.com/
# GEMINI_API_KEY=your_gemini_api_key_here

# === Development Settings ===
# Development logging is now AUTOMATIC (no manual flags needed!)
#
# Detection mechanism:
#   - If backend/.env.DEV file EXISTS → Development mode (logs field values)
#   - If backend/.env.DEV file MISSING → Production mode (no field values)
#
# To enable dev logging locally:
#   1. Create an empty file: touch backend/.env.DEV
#   2. Restart the backend server
#   3. You'll see: "🔍 [DevLogger] Development mode ENABLED"
#
# To disable dev logging:
#   1. Delete the file: rm backend/.env.DEV
#   2. Restart the backend server
#   3. You'll see: "🔒 [DevLogger] Production mode"
#
# NOTE: .env.DEV is gitignored and dockerignored - production will never have it!

# Google Cloud Project (for Vertex AI users)
# GOOGLE_CLOUD_PROJECT=your-project-id

# Other settings can be configured in config.py
# These environment variables will override the defaults in config.py
