node_modules/
.venv/
.env
.env.*
.env.DEV
.env.local
backend/.env
backend/.env.*
__pycache__/
**__pycache__**
**.pyc
*.pyo
.vscode/

# Allow .env.production / .env.demo (per-channel Vite build config). These hold
# only public VITE_* values -- the channel WS URL + Firebase WEB config, which is
# client-side and non-secret -- so committing them makes both channel builds
# reproducible on any checkout. Real secrets (e.g. GEMINI_API_KEY) never live
# here; they go in Secret Manager.
!.env.production
!.env.demo

# example data files
example_webforms/

# Test artifacts
.pytest_cache/

# Logs (generated files)
.logs/
*.log
backend.log
backend/logs/
# Confirmation-audit logs (one JSONL per form session; never commit real ones)
logs/confirmations/

# Build outputs
.frontend/dist/
frontend/dist/
frontend/public/form-kits/

# Temporary files
tmp_*
*.tmp

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/embeddeddolt/
.beads/.auto-import-*.jsonl
# dolt CLI cached by scripts/beads_remote_bootstrap.py (remote-session hydration)
.beads/.cache/
# experiment counter is a derived cache (counted from harness_ledger.jsonl by
# scripts/harness_ledger.py), not source of truth -- untracked so parallel
# closeouts can't collide on it (bd polyglot-pdf-8o4)
.beads/experiment_state.json
