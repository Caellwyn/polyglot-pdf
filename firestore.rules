rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User profile docs (users/{uid}): a signed-in user may read/write only
    // their own profile. Written by AuthContext.onAuthStateChanged on login.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Email-signup allowlist (authorized_emails): signUpWithEmail queries this
    // collection while the user is still UNAUTHENTICATED (before
    // createUserWithEmailAndPassword), so the read must be allowed without auth.
    // It is read-only -- never client-writable; entries are managed out of band
    // (Firebase Console / admin tooling). See docs/components/auth.md.
    match /authorized_emails/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // Firm records (firms/{firm_id}): Admin-SDK-only (bd polyglot-pdf-lo88).
    // The backend reads this collection via get_db() (firebase-admin), which
    // BYPASSES Security Rules entirely -- so this block grants/enables
    // nothing; it is an explicit defense-in-depth backstop ensuring no
    // client-SDK query can ever read or write firm profiles/allowlists, and
    // it self-documents that intent next to the other blocks rather than
    // relying on the trailing implicit default deny.
    // NOTE: rules reach the live project only via a frontend/full deploy
    // (deploy-demo.sh) or an explicit
    //   firebase deploy --only firestore:rules --project <project>
    // -- a backend-only deploy does NOT ship this file.
    match /firms/{firmId} {
      allow read, write: if false;
    }

    // Admin audit log (admin_audit_log/{auto}): Admin-SDK-only
    // (bd polyglot-pdf-li9x0). Written by admin_backend/services/audit_log.py
    // -- inside the mutation's own transaction for Firestore mutations, and
    // pending-then-committed for the ones Firestore cannot wrap -- and read
    // by GET /admin/audit on the admin SERVICE, never by a browser. The log
    // is append-only by writer discipline; this block is what stops a
    // client-SDK caller rewriting or deleting rows regardless.
    match /admin_audit_log/{rowId} {
      allow read, write: if false;
    }

    // Runtime config (app_config/{channel}): Admin-SDK-only
    // (bd polyglot-pdf-bg313, written by PUT /admin/config/{channel} and by
    // scripts/set_runtime_config.py; read by
    // backend/services/runtime_config.py). Client-writable config would let
    // a browser raise its own per-link USD spend ceiling.
    match /app_config/{channel} {
      allow read, write: if false;
    }
  }
}
