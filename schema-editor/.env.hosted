# Hosted delivery mode (bd polyglot-pdf-92qe.2): `npm run build:hosted` loads
# this file (vite --mode hosted). The build talks to the backend's
# editor/author-gated /api/editor routes (per-person Firebase identity, bd
# polyglot-pdf-hn0jq) instead of a local form-kits folder.
#
# VITE_API_BASE_URL: the Cloud Run backend URL. The hosted editor calls it
# DIRECTLY (not via the Firebase Hosting /api rewrite -- that rewrite has a 60s
# request cap that would kill minutes-long extraction runs). For a local
# full-stack test, point it at the local backend instead:
#   VITE_API_BASE_URL=http://localhost:8000
#
# FALLBACK ONLY: deploy-editor.sh resolves the LIVE Cloud Run URL at deploy time
# and exports VITE_API_BASE_URL (which overrides this line), because the auto-URL
# hash is NOT stable -- it drifted (d3mhrrkwfq -> won24rgefq) on a service
# recreate and every request then 404'd against the backend, looking like a
# broken deploy rather than a stale URL (bd polyglot-pdf-emm7). This committed
# value is used only if that resolution fails (or a local build with no
# gcloud); keep it roughly current but do not rely on it for deploys.
VITE_DELIVERY_MODE=hosted
VITE_API_BASE_URL=https://polyglot-backend-won24rgefq-uc.a.run.app

# Firebase sign-in (bd polyglot-pdf-yswp3). The editor authenticates each
# person individually against the SAME Firebase project the voice app uses --
# a second project is the separation epic's job, not this one's. These three
# keys are all the editor's sign-in needs (no storage/messaging/analytics ids:
# the editor writes no Firestore profile and reads no allowlist collection).
#
# NOT SECRETS: a Firebase web apiKey is a public client identifier, compiled
# into every browser bundle by design -- the voice app commits the same values
# in frontend/.env.demo. Access is gated by the schema_editor_role CUSTOM CLAIM
# the server checks (backend/services/editor_auth.py), granted per person with
#   python scripts/bootstrap_editor_user.py --email you@example.com --role editor
# Without that claim a valid sign-in is refused with 403, which is the point:
# holding the bundle grants nothing.
#
# A build missing these renders an explicit "this build has no Firebase
# configuration" screen rather than a sign-in form that cannot work.
VITE_FIREBASE_API_KEY=AIzaSyCR83_76OkNbAlSWgrz4hMLkoTS4vrRaOg
VITE_FIREBASE_AUTH_DOMAIN=polyglot-demo-aa709.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=polyglot-demo-aa709
