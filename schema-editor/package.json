{
  "name": "pdf-schema-editor",
  "version": "1.0.0",
  "type": "module",
  "description": "Visual editor for PDF form schemas",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:hosted": "tsc && vite build --mode hosted",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "pdfjs-dist": "6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "4.0.7",
    "@vitest/ui": "4.0.7",
    "autoprefixer": "^10.6.1",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.5.3",
    "vite": "^5.4.1",
    "vitest": "4.0.7"
  }
}
