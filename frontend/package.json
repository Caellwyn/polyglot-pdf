{
	"name": "web-form-voice-filler-frontend",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"form-kits:prepare": "tsx scripts/generate-form-manifest.ts",
		"dev": "vite",
		"predev": "npm run form-kits:prepare",
		"build": "vite build",
		"prebuild": "npm run form-kits:prepare",
		"build:worklet": "esbuild src/shared/audio-processor.worklet.ts --bundle --format=esm --target=es2020 --outfile=dist/shared/audio-processor.worklet.js && node -e \"require('fs').mkdirSync('public/shared', {recursive:true})\" && node -e \"require('fs').copyFileSync('dist/shared/audio-processor.worklet.js', 'public/shared/audio-processor.worklet.js')\"",
		"build:bookmarklet": "npm run build:worklet && vite build --config vite.config.bookmarklet.ts",
		"dev:demo": "npm run build:worklet && vite --config vite.config.demo.ts",
		"build:demo": "npm run build:worklet && vite build --config vite.config.demo.ts",
		"dev:vad": "npm run build:worklet && vite --config vite.config.vad.ts",
		"build:vad": "npm run build:worklet && vite build --config vite.config.vad.ts",
		"dev:schema": "vite --config vite.config.schema.ts",
		"predev:schema": "npm run form-kits:prepare",
		"build:schema": "vite build --config vite.config.schema.ts",
		"prebuild:schema": "npm run form-kits:prepare",
		"build:schema:demo": "vite build --config vite.config.schema.ts --mode demo",
		"prebuild:schema:demo": "npm run form-kits:prepare",
		"preview": "vite preview --port 5173",
		"prepreview": "npm run form-kits:prepare",
		"preview:demo": "vite preview --config vite.config.demo.ts --port 5174 --outDir dist/demo",
		"preview:vad": "vite preview --config vite.config.vad.ts --port 5175 --outDir dist/vad-tuning",
		"preview:schema": "vite preview --config vite.config.schema.ts --port 5176",
		"prepreview:schema": "npm run form-kits:prepare",
		"test": "vitest --environment jsdom",
		"pretest": "npm run form-kits:prepare",
		"test:run": "vitest run",
		"pretest:run": "npm run form-kits:prepare",
		"test:coverage": "vitest run --coverage",
		"pretest:coverage": "npm run form-kits:prepare",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"parse": "tsx scripts/parse-form.ts",
		"gen:form-manifest": "tsx scripts/generate-form-manifest.ts",
		"postinstall": "npm run form-kits:prepare",
		"deploy": "npm run build:schema && firebase deploy --only firestore:rules,hosting:app --project polyglot-forms-919f2",
		"deploy:demo": "npm run build:schema:demo && firebase deploy --only hosting:app --project polyglot-demo-aa709"
	},
	"dependencies": {
		"@ricky0123/vad-react": "^0.0.37",
		"chart.js": "^4.5.1",
		"chartjs-plugin-annotation": "^3.1.0",
		"firebase": "^13.0.0",
		"pdf-lib": "^1.17.1",
		"pdfjs-dist": "6.4.299",
		"react": "^19.3.1",
		"react-chartjs-2": "^5.3.0",
		"react-dom": "^19.3.1",
		"react-router-dom": "^7.18.4"
	},
	"devDependencies": {
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.8",
		"@types/node": "^20.11.0",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^4.3.0",
		"@vitejs/plugin-react-swc": "^4.2.0",
		"@vitest/coverage-v8": "^3.2.6",
		"jsdom": "^30.1.3",
		"tsx": "^4.23.15",
		"typescript": "^5.4.0",
		"vite": "^6.4.3",
		"vitest": "^3.2.6"
	}
}
