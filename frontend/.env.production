# Production environment variables (polyglot-forms-919f2)
# Used when building with: npm run build:schema (no --mode flag = production)
# Can be overridden by VITE_* variables passed on command line

# Production backend URL - polyglot-backend Cloud Run service.
# FALLBACK ONLY: deploy-all.sh resolves the LIVE Cloud Run URL at deploy time and
# passes it as VITE_WS_URL (which overrides this line), because the auto-URL hash
# is NOT stable and drifts on a service recreate (bd polyglot-pdf-emm7). This
# committed value is used only if that resolution fails; the hash below is stale
# (the service was recreated) and is intentionally left as a non-load-bearing
# placeholder -- a real prod deploy resolves the live URL.
VITE_WS_URL=wss://polyglot-backend-PLACEHOLDER-uc.a.run.app/ws/fill

# Firebase config - polyglot-forms-919f2 (PRODUCTION project)
# REQUIRED: without these the prod build ships an undefined Firebase config and
# the app dies at launch with "auth/invalid-api-key". Fill from the Firebase
# console (Project settings > General > Your apps > Web app > SDK config), or:
#   firebase apps:sdkconfig web --project polyglot-forms-919f2
# (run while logged in as josh@caellwynai.com). These are client-side public
# config values, not secrets -- safe to commit in this tracked file.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=polyglot-forms-919f2.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=polyglot-forms-919f2
VITE_FIREBASE_STORAGE_BUCKET=polyglot-forms-919f2.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
