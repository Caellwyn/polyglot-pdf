# Demo environment variables (polyglot-demo-aa709)
# Used when building with: npm run build:schema:demo (--mode demo)
# Can be overridden by VITE_* variables passed on command line

# Demo backend URL - polyglot-backend Cloud Run service.
# FALLBACK ONLY: deploy-all.sh resolves the LIVE Cloud Run URL at deploy time and
# passes it as VITE_WS_URL (which overrides this line), because the auto-URL hash
# is NOT stable and drifts on a service recreate (bd polyglot-pdf-emm7). This
# committed value is used only if that resolution fails (e.g. a local build with
# no gcloud); keep it roughly current but do not rely on it for deploys.
VITE_WS_URL=wss://polyglot-backend-won24rgefq-uc.a.run.app/ws/fill

# Admin service URL - polyglot-admin Cloud Run service (bd polyglot-pdf-z4ljj).
# FALLBACK ONLY, same reasoning as VITE_WS_URL above: deploy-all.sh resolves
# the LIVE polyglot-admin Cloud Run URL at deploy time and exports
# VITE_ADMIN_API_BASE_URL (which overrides this line). Mirrors the SAME
# literal admin-console/.env.hosted commits for the standalone admin console.
# Used by the main app's firm-console pages (frontend/src/console/*).
VITE_ADMIN_API_BASE_URL=https://polyglot-admin-uc.a.run.app

# This build's own channel (bd polyglot-pdf-z4ljj): required on every
# firm-scoped admin-service call as `?channel=`, since the admin service has
# no channel identity of its own (see docs/components/config-deployment.md,
# "Frontend"). Left UNSET here deliberately -- config.ts's getAppChannel()
# already defaults an unset/unrecognized value to 'demo', and BOTH
# deploy-staging.sh and deploy-demo.sh export VITE_APP_CHANNEL explicitly on
# their own deploy-all.sh invocation, overriding whatever this file says. A
# committed literal here would only be wrong for the ONE channel that reuses
# this env file's Firebase keys but is NOT demo (staging) -- the two channel
# wrappers being the sole real callers of this file means the override always
# applies at deploy time; this line exists only to document the default a
# local/uninjected build falls back to.
# VITE_APP_CHANNEL=demo

# Firebase config - polyglot-demo-aa709
VITE_FIREBASE_API_KEY=AIzaSyCR83_76OkNbAlSWgrz4hMLkoTS4vrRaOg
VITE_FIREBASE_AUTH_DOMAIN=polyglot-demo-aa709.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=polyglot-demo-aa709
VITE_FIREBASE_STORAGE_BUCKET=polyglot-demo-aa709.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=775682479028
VITE_FIREBASE_APP_ID=1:775682479028:web:7c68c5d579faecdc7398e1
VITE_FIREBASE_MEASUREMENT_ID=G-X0BHXKCYYX
